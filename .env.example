# App environment: only "production" turns on Google Analytics
NEXT_PUBLIC_APP_ENV=development

# Public URL of the site, used by sitemap.xml, robots.txt and Open Graph (no trailing slash)
NEXT_PUBLIC_SITE_URL=https://cuartetofratres.com

# Google Analytics 4 (Measurement ID, public)
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Payload CMS (/admin). PAYLOAD_SECRET signs the sessions: any long random
# string. DATABASE_URI is a Postgres connection string; locally, any Postgres
# works (`npm run cms:migrate` creates the tables). Use sslmode=verify-full for
# a remote one: with sslmode=require the pg driver warns about a semantic change.
# On Vercel it can stay unset: CUARTETO_FRATRES_DATABASE_POSTGRES_URL, created
# by the Prisma Postgres integration, is the fallback (payload.config.ts).
PAYLOAD_SECRET=
DATABASE_URI=

# Vercel Blob token for the CMS uploads. Every Vercel deployment sets it;
# locally leave it empty and the files are written to ./media.
BLOB_READ_WRITE_TOKEN=
