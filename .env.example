# App environment: only "production" turns on Google Analytics
NEXT_PUBLIC_APP_ENV=development

# Public URL of the site, used by sitemap.xml, robots.txt and Open Graph (no trailing slash)
NEXT_PUBLIC_SITE_URL=https://cuartetofratres.com

# Google Analytics 4 (Measurement ID, public)
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Where the contact form is delivered. When empty, requests are only logged
# on the server (one JSON line each), which is what local development does.
CONTACT_WEBHOOK_URL=
